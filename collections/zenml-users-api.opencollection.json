{
  "opencollection": "1.0.0",
  "info": {
    "name": "ZenML OSS REST Artifacts Users API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Current Authenticated User",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://your-zenml-server.example.com/api/v1/current-user"
          },
          "docs": "Get Current Authenticated User"
        },
        {
          "info": {
            "name": "List Users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://your-zenml-server.example.com/api/v1/users",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "size",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List Users"
        }
      ]
    }
  ],
  "bundled": true
}