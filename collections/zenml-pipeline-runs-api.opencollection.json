{
  "opencollection": "1.0.0",
  "info": {
    "name": "ZenML OSS REST Artifacts Pipeline Runs API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Pipeline Runs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Pipeline Runs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://your-zenml-server.example.com/api/v1/runs",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "size",
                "value": "",
                "type": "query"
              },
              {
                "name": "pipeline_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List Pipeline Runs"
        },
        {
          "info": {
            "name": "Get Pipeline Run",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://your-zenml-server.example.com/api/v1/runs/:run_id",
            "params": [
              {
                "name": "run_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Pipeline Run"
        }
      ]
    }
  ],
  "bundled": true
}